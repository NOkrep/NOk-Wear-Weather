# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional absolute persistent directory for the single-instance community pilot.
# Default: .data/community under the app working directory. Never commit this data.
# Multi-instance hosting requires a transactional shared database instead.
# WEAR_WEATHER_COMMUNITY_DIR="/persistent/weathrobe-community"

# Catalogue foundation (17 October 2026). Never put database variables in NEXT_PUBLIC_*.
# Local Next.js can omit DATABASE_URL and continue with the 23 historical profiles.
# CLI reads .env; Next.js also supports .env.local. Use one source of truth per environment.
# DATABASE_URL="postgresql://weathrobe_owner:URL_ENCODED_PASSWORD@127.0.0.1:5432/weathrobe"
# For Docker Compose, generate TWO DIFFERENT 64-character hex passwords (see db/README.md).
# POSTGRES_PASSWORD=""
# CATALOG_READER_PASSWORD=""
# APP_DOMAIN="weather.example.com"
# APP_URL="https://weather.example.com"
